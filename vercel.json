{
  "$schema": "https://openapi.vercel.sh/vercel.json",

  "git": {
    "deploymentEnabled": {
      "codex/multi-brand-location-staging": false
    }
  },

  "crons": [
    {
      "path": "/api/cron/auto-scan",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/credit-rollover",
      "schedule": "10 0 * * *"
    }
  ]
}
