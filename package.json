{
  "name": "affiliate-finder",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:staging": "node scripts/build-staging.mjs",
    "build:staging:feature-on": "node scripts/build-staging.mjs --feature-on",
    "start": "next start",
    "lint": "eslint",
    "type-check": "tsc --noEmit",
    "test:foundation": "node --import tsx --test tests/foundation/*.test.ts",
    "test:server": "node --conditions=react-server --import tsx --test tests/server/*.test.ts",
    "test:staging:affiliate-isolation": "node --import tsx scripts/verify-affiliate-location-isolation-staging.ts",
    "test:staging:brand-location-management": "node --conditions=react-server --import tsx scripts/verify-brand-location-management-staging.ts",
    "test:staging:onboarding-suggestions": "node --env-file=.env.staging.local --conditions=react-server --import tsx scripts/verify-onboarding-suggestions-staging.ts",
    "test:staging:account-identity": "node --conditions=react-server --import tsx scripts/verify-account-identity-staging.ts",
    "test:staging:stripe-webhooks": "node --env-file=.env.staging.local --conditions=react-server --import tsx scripts/verify-stripe-webhook-events-staging.ts",
    "test:staging:stripe-plan-changes": "node --conditions=react-server --import tsx scripts/verify-deferred-plan-changes-staging.ts",
    "test:staging:stripe-billing-consistency": "node --env-file=.env.staging.local --conditions=react-server --import tsx scripts/verify-stripe-billing-consistency-staging.ts",
    "test:staging:downgrade-capacity": "node --conditions=react-server --import tsx scripts/verify-downgrade-capacity-staging.ts",
    "test:staging:weekly-auto-scan": "node --import tsx scripts/verify-weekly-auto-scan-staging.ts",
    "test:staging:weekly-persistence": "node --conditions=react-server --import tsx scripts/verify-weekly-affiliate-persistence-staging.ts",
    "test:staging:reconciliation": "node --conditions=react-server --import tsx scripts/verify-search-reconciliation-staging.ts",
    "test:staging:search-credits": "node --conditions=react-server --import tsx scripts/verify-search-credit-reservations-staging.ts",
    "test:staging:paid-search-migration": "node --import tsx scripts/verify-paid-search-migration-staging.ts",
    "fixture:staging:multi-location": "node --import tsx scripts/manage-ui-multi-location-fixture.ts",
    "operator:provision": "node --import tsx scripts/provision-search-reconciliation-operator.ts",
    "migration:verify": "node scripts/migrations/manage.mjs --verify",
    "migration:status": "node scripts/migrations/manage.mjs --status",
    "prebuild": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.72.1",
    "@mendable/firecrawl-js": "^4.10.0",
    "@neondatabase/serverless": "^1.0.2",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.0.8",
    "@stackframe/stack": "^2.8.54",
    "@stripe/react-stripe-js": "^5.4.1",
    "@stripe/stripe-js": "^8.5.3",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.90.1",
    "@types/micro": "^7.3.7",
    "@vercel/functions": "^3.3.4",
    "apify-client": "^2.20.0",
    "dotenv": "^17.2.3",
    "framer-motion": "^12.23.24",
    "franc": "^6.2.0",
    "ipaddr.js": "2.5.0",
    "jose": "^6.1.3",
    "micro": "^10.0.1",
    "next": "16.3.4",
    "postgres": "^3.4.8",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "recharts": "^3.5.1",
    "resend": "^6.12.2",
    "server-only": "0.0.1",
    "sonner": "^2.0.7",
    "stripe": "^20.0.0",
    "swr": "^2.3.8",
    "zod": "^4.3.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.17",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.22",
    "clsx": "^2.1.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "lucide-react": "^0.554.0",
    "pg": "^8.18.0",
    "postcss": "^8.5.6",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.17",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
